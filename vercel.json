{
    "version": 2,
    "outputDirectory": "frontend/dist",
    "functions": {
        "api/index.js": {
            "includeFiles": "Skills/**"
        }
    },
    "rewrites": [
        {
            "source": "/api/test",
            "destination": "/api/test.js"
        },
        {
            "source": "/api/debug",
            "destination": "/api/debug.js"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}