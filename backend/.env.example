# Backend Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (required for AI analysis)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# OpenAI Model (optional - defaults to gpt-5.2)
# Options: gpt-5.2, gpt-5, gpt-4.5-turbo, gpt-4-turbo, gpt-4
OPENAI_MODEL=gpt-5.2

# ClickUp API Token (get from ClickUp Settings > Apps)
# Get yours at: https://app.clickup.com/settings/apps
CLICKUP_API_TOKEN=pk_your-clickup-token-here

# ClickUp Space ID (where to create projects)
# Find in ClickUp URL: clickup.com/123456/home (123456 is the space ID)
CLICKUP_SPACE_ID=your-space-id

# Server Port
PORT=3001
